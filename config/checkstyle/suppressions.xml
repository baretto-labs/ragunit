<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suppressions PUBLIC
        "-//Checkstyle//DTD SuppressionFilter Configuration 1.0//EN"
        "https://checkstyle.org/dtds/suppressions_1_0.dtd">

<!--
    Checkstyle suppressions for RAGUnit.
    Each suppression targets a specific check in a specific file pattern.
    Production code is never suppressed. Only test conventions are accommodated.
-->
<suppressions>

    <!--
        Test methods follow the should_X_when_Y naming convention (defined in CLAUDE.md).
        Underscores are intentional: they separate the behavior from the condition,
        making test intent readable at a glance without opening the method body.
        This suppression applies ONLY to *Test.java files.
    -->
    <suppress checks="MethodName" files="(Test|Example)\.java$"/>


    <!--
        Fluent builder classes use method parameters that intentionally match field names
        (e.g., forQuestion(Question question), evaluatedBy(RagJudge judge)).
        Checkstyle 9.3 setterCanReturnItsClass only applies to set-prefixed methods.
        The pattern is deliberate: same name = same concept, no confusion for readers.
    -->
    <suppress checks="HiddenField" files="Assert\.java$"/>

    <!--
        Test code uses literal numbers for readability (e.g. rank=3, count=10, ratio=0.67).
        Extracting every numeric constant in tests adds noise without improving clarity.
    -->
    <suppress checks="MagicNumber" files="(Test|Example)\.java$"/>

    <!--
        VerdictParser, Verdict, JsonTestsetImporter, and CsvTestsetImporter contain
        inherently complex parsing logic (brace-tracking, RFC 4180 state machine).
        The cyclomatic complexity and method length are acceptable given the algorithmic
        nature of the code; refactoring would harm readability without reducing complexity.
    -->
    <suppress checks="CyclomaticComplexity|MethodLength"
              files="VerdictParser\.java|Verdict\.java|JsonTestsetImporter\.java|CsvTestsetImporter\.java"/>

</suppressions>
